<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <title>Ticket #{{ ticket.id }}</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f6f8;
            padding: 40px;
        }

        .container {
            max-width: 700px;
            margin: auto;
            background: white;
            padding: 30px;
            border-radius: 10px;
        }

        h1 {
            margin-bottom: 30px;
        }

        .info {
            margin-bottom: 20px;
        }

        .label {
            font-weight: bold;
            margin-bottom: 5px;
        }

        .btn {
            display: inline-block;
            padding: 10px 15px;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            margin-right: 10px;
        }

        .btn-edit {
            background-color: #2563eb;
        }

        .btn-back {
            background-color: #64748b;
        }

        .success {
            background-color: #dcfce7;
            color: #166534;
            padding: 12px;
            border-radius: 5px;
            margin-bottom: 20px;
        }
    </style>
</head>

<body>

<div class="container">

    <h1>🎫 Ticket #{{ ticket.id }}</h1>

    {% for message in app.flashes('success') %}
        <div class="success">
            {{ message }}
        </div>
    {% endfor %}

    <div class="info">
        <div class="label">Auteur :</div>
        {{ ticket.auteur }}
    </div>

    <div class="info">
        <div class="label">Description :</div>
        {{ ticket.description }}
    </div>

    <div class="info">
        <div class="label">Catégorie :</div>
        {{ ticket.categorie ? ticket.categorie.nom : '-' }}
    </div>

    <div class="info">
        <div class="label">État :</div>
        {{ ticket.etat ? ticket.etat.nom : '-' }}
    </div>

    <div class="info">
        <div class="label">Responsable :</div>
        {{ ticket.responsable ? ticket.responsable.email : '-' }}
    </div>

    <div class="info">
        <div class="label">Date d'ouverture :</div>

        {{ ticket.dateOuverture
            ? ticket.dateOuverture|date('d/m/Y H:i')
            : '-'
        }}
    </div>

    <div class="info">
        <div class="label">Date de clôture :</div>

        {{ ticket.dateCloture
            ? ticket.dateCloture|date('d/m/Y H:i')
            : '-'
        }}
    </div>

    <br>

    <a
        href="{{ path('employe_ticket_etat', {'id': ticket.id}) }}"
        class="btn btn-edit"
    >
        🔄 Modifier l'état
    </a>

    <a
        href="{{ path('employe_tickets') }}"
        class="btn btn-back"
    >
        ← Retour aux tickets
    </a>

</div>

</body>

</html>